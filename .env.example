# 後端 API 位址（不含 /api 前綴後的路徑，僅 host + port）
# 範例：http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# 案例實績資料來源開關
# true  = 使用瀏覽器 localStorage（開發時可離線編輯）
# false = 使用後端 API（資料永久化，需同時設定 NEXT_PUBLIC_API_BASE_URL）
# 未設定 = 有 API_BASE_URL 則用 API，否則用 localStorage
NEXT_PUBLIC_USE_PROJECT_MOCK=false
